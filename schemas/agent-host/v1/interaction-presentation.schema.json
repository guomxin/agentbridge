{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentbridge.local/schemas/agent-host/v1/interaction-presentation.schema.json",
  "title": "AgentBridge Trusted Interaction Presentation",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "interactionId", "type", "state", "presentation", "resume"],
  "properties": {
    "schemaVersion": {"const": "agentbridge.interaction.v1"},
    "interactionId": {"type": "string", "minLength": 16, "maxLength": 128},
    "type": {"enum": ["credential", "business_input", "execution_authorization"]},
    "state": {"enum": ["pending", "processing", "completed", "declined", "expired", "failed", "superseded"]},
    "display": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "businessView": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schemaVersion", "profileId", "profileVersion", "viewKind", "entryLabel", "submitLabel"],
          "properties": {
            "schemaVersion": {"const": "agentbridge.business-view.v1"},
            "profileId": {"enum": ["taihua.work_log.create", "oa.meeting_room.application.create", "oa.leave.approval"]},
            "profileVersion": {"const": "1"},
            "viewKind": {"enum": ["work_log", "meeting_room", "approval"]},
            "entryLabel": {"type": "string", "maxLength": 40},
            "submitLabel": {"type": "string", "maxLength": 40}
          }
        }
      }
    },
    "presentation": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "uiResourceUri": {"type": "string"},
        "hostHandled": {"type": "boolean"},
        "flowVersion": {"const": "agentbridge.trusted-flow.v1"}
      }
    },
    "resume": {
      "type": "object",
      "required": ["ready", "completed"],
      "properties": {
        "ready": {"type": "boolean"},
        "completed": {"type": "boolean"}
      }
    }
  }
}
