{
  "capabilities": [
    {
      "name": "oa.meeting.reply.prepare",
      "version": "0.1.0",
      "description": "Review one current meeting invitation and collect an explicit attendance response in a trusted card.",
      "input_schema": {
        "type": "object",
        "properties": {
          "affair_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "input_submission_id": {
            "type": "string"
          }
        },
        "required": [
          "affair_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "effect": "controlled_write",
      "adapter": "seeyon-central",
      "workflow": "meeting-reply-prepare-v1",
      "system": "oa"
    },
    {
      "name": "oa.meeting.reply",
      "version": "0.1.0",
      "description": "Consume one authorization, recheck the exact meeting and reply once, then verify the current user receipt.",
      "input_schema": {
        "type": "object",
        "properties": {
          "authorization_id": {
            "type": "string"
          }
        },
        "required": [
          "authorization_id"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "effect": "controlled_write",
      "adapter": "seeyon-central",
      "workflow": "meeting-reply-commit-v1",
      "system": "oa"
    }
  ],
  "definition": {
    "commit_capability": "oa.meeting.reply",
    "field_schema": {
      "schema_version": "agentbridge.oa_meeting_reply_fields.v1",
      "title": "核对会议并回复",
      "system": "致远 OA",
      "effect": "向会议发起人提交本人的参会回执",
      "submit_label": "提交字段",
      "notice": "请选择本人的参会意向，核对后再确认回复。",
      "fields": [
        {
          "name": "attitude",
          "label": "参会意向",
          "control": "select",
          "required": true,
          "options": [
            {
              "value": "join",
              "label": "参加"
            },
            {
              "value": "not_join",
              "label": "不参加"
            },
            {
              "value": "pending",
              "label": "待定"
            }
          ]
        },
        {
          "name": "feedback",
          "label": "回复说明",
          "control": "textarea",
          "required": false,
          "max_length": 1000,
          "rows": 3
        }
      ]
    },
    "context_fields": [
      "affair_id"
    ],
    "prepare_function": "prepare_meeting_reply",
    "commit_function": "commit_meeting_reply",
    "contract_error": "agentbridge.adapters.seeyon_meeting_reply.MeetingReplyContractMismatch",
    "outcome_error": "agentbridge.adapters.seeyon_meeting_reply.MeetingReplyOutcomeUnknown",
    "field_message": "请在可信办理卡选择本人的参会意向。",
    "authorization_message": "请核对会议和参会意向后确认回复。",
    "preflight_function": "preflight_meeting_reply",
    "preflight_profile": "meeting_reply"
  },
  "permission": {
    "id": "oa.meeting.reply",
    "label": "会议邀请回复",
    "capabilities": [
      "oa.meeting.reply.prepare",
      "oa.meeting.reply"
    ],
    "tools": [
      "oa_meeting_reply_prepare"
    ],
    "legacy_scopes": [
      "oa:write:meeting"
    ],
    "dependencies": "本人当前会议邀请与 OA 回复权限核验",
    "resource": "绑定下游账号本人的会议回执"
  },
  "planning": {
    "oa.meeting.reply.prepare": null,
    "oa.meeting.reply": null
  }
}
