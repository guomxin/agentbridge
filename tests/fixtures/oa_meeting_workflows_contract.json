          },
          "effect": "controlled_write",
          "adapter": "seeyon-central",
          "workflow": "meeting-create-prepare-v1",
          "system": "oa"
        },
        {
          "name": "oa.meeting.create",
          "version": "0.1.0",
          "description": "Consume one trusted authorization, recheck room availability, create and send the meeting, then verify room-list and meeting-view readback.",
