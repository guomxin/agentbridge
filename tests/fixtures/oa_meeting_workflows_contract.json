            "type": "object",
            "properties": {
              "authorization_id": {
                "type": "string"
              }
            },
            "required": [
              "authorization_id"
            ],
            "additionalProperties": false
          },
          "output_schema": {
            "type": "object"
          },
          "effect": "controlled_write",
          "adapter": "seeyon-central",
          "workflow": "meeting-create-commit-v1",
          "system": "oa"
        }
      ],
      "definition": {
        "commit_capability": "oa.meeting.create",
        "field_schema": {
          "schema_version": "agentbridge.oa_meeting_create_fields.v1",
          "title": "填写会议创建信息",
          "system": "致远 OA",
          "effect": "创建并发送完整会议，可同时占用会议室",
          "submit_label": "提交字段",
          "notice": "这是会议创建流程，不是独立会议室申请。字段提交后还需单独授权；授权前不会创建或发送会议。",
          "fields": [
            {
              "name": "subject",
              "label": "会议主题",
              "control": "text",
              "required": true,
              "max_length": 255,
              "autocomplete": "off"
            },
            {
              "name": "room",
              "label": "会议室",
              "control": "text",
              "required": true,
              "max_length": 100,
              "autocomplete": "off"
            },
            {
              "name": "start_time",
              "label": "开始时间",
              "control": "datetime-local",
              "required": true
            },
            {
              "name": "end_time",
              "label": "结束时间",
              "control": "datetime-local",
              "required": true
            }
          ],
          "constraints": [
            {
              "kind": "datetime_after",
              "earlier": "start_time",
              "later": "end_time",
              "maximum_minutes": 10080,
              "message": "结束时间必须晚于开始时间，且会议时长不能超过 7 天。"
            }
          ]
        },
        "field_schema_function": "build_meeting_field_card_schema",
        "context_fields": [],
        "prepare_function": "prepare_meeting_create",
        "commit_function": "create_meeting",
        "contract_error": "bscli.adapters.seeyon_meeting.MeetingContractMismatch",
        "outcome_error": "bscli.adapters.seeyon_meeting.MeetingOutcomeUnknown",
        "field_message": "Meeting fields must be entered in the trusted field card.",
        "authorization_message": "The meeting-create plan requires confirmation in the trusted action card."
      },
      "scopes": {
        "oa.meeting.create.prepare": [
          "oa:write:meeting"
        ],
        "oa.meeting.create": [
          "oa:write:meeting"
        ]
      },
      "permissions": {
        "oa.meeting.create.prepare": "oa.meeting.create",
        "oa.meeting.create": "oa.meeting.create"
      },
      "permission_definitions": {
        "oa.meeting.create": {
          "id": "oa.meeting.create",
          "label": "创建会议",
          "capabilities": [
            "oa.meeting.create",
            "oa.meeting.create.prepare"
          ],
          "tools": [
            "oa_meeting_create_prepare"
          ],
          "legacy_scopes": [
            "oa:write:meeting"
          ],
          "dependencies": "选人流程如调用通讯录，另检查通讯录查询",
          "resource": "绑定下游账号实际可见范围",
          "private_tools": [
            "oa_meeting_create"
          ]
        }
      },
      "planning": {
        "oa.meeting.create.prepare": null,
        "oa.meeting.create": null
