# Example only: supply a reviewed external environment profile for deployment.
[Unit]
Description=AgentBridge consistent runtime-state backup
After=agentbridge.service

[Service]
Type=oneshot
User=agentbridge
Group=agentbridge
WorkingDirectory=/home/agentbridge/service
Environment=HOME=/home/agentbridge/service/data
Environment=PYTHONUNBUFFERED=1
Environment=AGENTBRIDGE_SESSION_KEY_FILE=/home/agentbridge/service/config/session.key
EnvironmentFile=-/home/agentbridge/service/config/release.env
ExecStart=/home/agentbridge/service/current/venv/bin/python -P -m agentbridge.cli.main --home /home/agentbridge/service/data diagnostics backup-create --output-dir /home/agentbridge/service/backups
ExecStart=/usr/bin/find /home/agentbridge/service/backups -maxdepth 1 -type f -mtime +30 -delete
UMask=0077
TimeoutStartSec=360
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadOnlyPaths=/home/agentbridge/service/config
ReadWritePaths=/home/agentbridge/service/data /home/agentbridge/service/backups
